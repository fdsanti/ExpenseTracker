<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp">
        <shape>
            <solid android:color="?attr/categoryDialogSecondaryShadowColor" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <solid android:color="?attr/categoryDialogSecondaryBg" />
            <stroke
                android:width="1dp"
                android:color="?attr/categoryDialogSecondaryBorderColor" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
