<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_category_dialog"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/txtCategoryDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rajdhani_semibold"
        android:includeFontPadding="false"
        android:textColor="?attr/categoryDialogText"
        android:textSize="24sp"
        app:fontFamily="@font/rajdhani_semibold" />

    <TextView
        android:id="@+id/txtCategoryDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/rajdhani_regular"
        android:includeFontPadding="false"
        android:textColor="?attr/categoryDialogText"
        android:textSize="16sp"
        android:visibility="gone"
        app:fontFamily="@font/rajdhani_regular" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editCategoryDialogName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_category_dialog_field"
        android:fontFamily="@font/rajdhani_regular"
        android:includeFontPadding="false"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="?attr/categoryDialogFieldText"
        android:textColorHint="#BEB9C7"
        android:textSize="18sp"
        app:fontFamily="@font/rajdhani_regular" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCategoryDialogSecondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_category_dialog_secondary_button"
            android:fontFamily="@font/rajdhani_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Cancelar"
            android:textColor="#252525"
            android:textSize="16sp"
            app:fontFamily="@font/rajdhani_semibold" />

        <TextView
            android:id="@+id/btnCategoryDialogPrimary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_debt_closing_button_shadow"
            android:fontFamily="@font/rajdhani_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Guardar"
            android:textColor="?attr/debtClosingButtonTextColor"
            android:textSize="16sp"
            app:fontFamily="@font/rajdhani_semibold" />
    </LinearLayout>
</LinearLayout>
