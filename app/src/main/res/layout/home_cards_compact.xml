<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/trackerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:elevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tracker_card_shadow"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingRight="40dp">

                <TextView
                    android:id="@+id/txtName"
                    style="@style/HomeCardCompactTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Titulo" />

                <TextView
                    android:id="@+id/txtOpenBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="21dp"
                    android:layout_marginStart="12dp"
                    android:layout_alignTop="@id/txtName"
                    android:layout_alignBottom="@id/txtName"
                    android:layout_toEndOf="@id/txtName"
                    android:background="@drawable/bg_home_open_badge"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="31dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Sin cerrar"
                    android:textColor="?attr/contentCategoryPercentageText"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/icn_cerrado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_alignTop="@id/txtName"
                    android:layout_alignBottom="@id/txtName"
                    android:layout_toEndOf="@id/txtOpenBadge"
                    android:contentDescription="icn_cerrado"
                    android:src="@drawable/baseline_verified_24"
                    app:tint="?attr/whiteBlack" />

                <TextView
                    android:id="@+id/txtDate"
                    style="@style/HomeCardDateText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </RelativeLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:contentDescription="Right Arrow"
                android:src="@drawable/chevronright"
                app:tint="?attr/whiteBlack" />
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
